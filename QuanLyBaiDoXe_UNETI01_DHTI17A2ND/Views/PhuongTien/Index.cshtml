@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 3 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.PhuongTienFilterViewModel
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels
@{
    bool isAdmin = Context.Session.GetString("VaiTro") == "Admin";
    ViewData["Title"] = isAdmin ? "Quản Lý Phương Tiện" : "Phương Tiện Của Tôi";
    var pt = new PhanTrangViewModel
    {
        Action = "Index", PageIndex = Model.PageIndex, TotalPages = Model.TotalPages,
        RouteValues = new() { ["searchBienSo"] = Model.SearchBienSo, ["searchChu"] = Model.SearchChu,
            ["selectedMaLoai"] = Model.SelectedMaLoai?.ToString(), ["trangThai"] = Model.TrangThai, ["sortOrder"] = Model.SortOrder }
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary fw-bold">🏍️ @(isAdmin ? "QUẢN LÝ PHƯƠNG TIỆN" : "PHƯƠNG TIỆN CỦA TÔI")</h2>
    <a asp-action="Create" class="btn btn-success fw-bold">+ Thêm phương tiện</a>
</div>
<div class="card p-3 mb-3 bg-light border-0 shadow-sm">
    <form asp-action="Index" method="get" class="row g-2">
        <div class="col-md-3"><input name="searchBienSo" value="@Model.SearchBienSo" class="form-control" placeholder="Biển số / nhãn hiệu..." /></div>
        @if (isAdmin) { <div class="col-md-2"><input name="searchChu" value="@Model.SearchChu" class="form-control" placeholder="Tên chủ xe..." /></div> }
        <div class="col-md-2"><select name="selectedMaLoai" asp-items="Model.LoaiList" class="form-select"><option value="">-- Loại xe --</option></select></div>
        <div class="col-md-2">
            <select name="trangThai" class="form-select">
                <option value="">-- Trạng thái --</option>
                <option value="hoatdong" selected="@(Model.TrangThai == "hoatdong")">Hoạt động</option>
                <option value="ngung" selected="@(Model.TrangThai == "ngung")">Ngừng</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Biển số A-Z</option>
                <option value="bien_desc" selected="@(Model.SortOrder == "bien_desc")">Biển số Z-A</option>
            </select>
        </div>
        <div class="col-md-1 d-grid"><button class="btn btn-primary">Lọc</button></div>
    </form>
</div>
<table class="table table-bordered table-hover align-middle bg-white shadow-sm">
    <thead class="table-primary text-center">
        <tr><th>Biển số</th><th>Loại</th><th>Nhãn hiệu</th><th>Màu</th>@if (isAdmin) { <th>Chủ xe</th> }<th>Trạng thái</th><th>Thao tác</th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model.DanhSach)
    {
        <tr>
            <td class="fw-bold">@p.BienSoXe</td>
            <td><span class="badge bg-info text-dark">@p.LoaiPhuongTien?.TenLoaiPhuongTien</span></td>
            <td>@p.NhanHieu</td>
            <td>@p.MauSac</td>
            @if (isAdmin) { <td>@p.ChuPhuongTien?.HoTen</td> }
            <td class="text-center">@if (p.TrangThai) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
            <td class="text-center">
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@p.MaPhuongTien" class="btn btn-outline-info">Xem</a>
                    <a asp-action="Edit" asp-route-id="@p.MaPhuongTien" class="btn btn-outline-primary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@p.MaPhuongTien" class="btn btn-outline-danger">Xóa</a>
                </div>
            </td>
        </tr>
    }
    @if (!Model.DanhSach.Any()) { <tr><td colspan="@(isAdmin ? 7 : 6)" class="text-center text-muted py-3">Không có phương tiện phù hợp.</td></tr> }
    </tbody>
</table>
<partial name="_PhanTrang" model="pt" />
