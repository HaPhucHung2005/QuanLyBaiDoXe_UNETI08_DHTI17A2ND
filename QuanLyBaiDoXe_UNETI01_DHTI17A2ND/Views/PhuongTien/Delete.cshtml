@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhuongTien
@{ ViewData["Title"] = "Xóa phương tiện"; }
<h2 class="text-danger fw-bold mb-3">Xóa phương tiện</h2>
<div class="alert alert-warning">Bạn có chắc muốn xóa phương tiện <strong>@Model.BienSoXe</strong> (@Model.LoaiPhuongTien?.TenLoaiPhuongTien - @Model.ChuPhuongTien?.HoTen)?</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MaPhuongTien" />
    <button class="btn btn-danger">Xác nhận xóa</button> <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
