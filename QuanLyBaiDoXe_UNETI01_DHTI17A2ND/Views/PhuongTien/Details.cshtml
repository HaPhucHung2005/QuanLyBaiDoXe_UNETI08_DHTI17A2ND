@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Giao diện Xem chi tiết Phương tiện (Module 3)
*@

@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhuongTien

@{
    ViewData["Title"] = "Chi Tiết Phương Tiện";
}

<div class="container mt-4">
    <div class="card shadow-sm border-primary mx-auto" style="max-width: 700px;">
        <div class="card-header bg-primary text-white text-center fw-bold fs-5">
            THÔNG TIN CHI TIẾT PHƯƠNG TIỆN
        </div>
        <div class="card-body">
            <dl class="row px-3 fs-6">
                <dt class="col-sm-4 fw-bold mb-2">Mã phương tiện:</dt>
                <dd class="col-sm-8 mb-2">#@Model.MaPhuongTien</dd>

                <dt class="col-sm-4 fw-bold mb-2">Biển số xe:</dt>
                <dd class="col-sm-8 mb-2 text-primary fw-bold fs-5">@Model.BienSoXe</dd>

                <dt class="col-sm-4 fw-bold mb-2">Loại phương tiện:</dt>
                <dd class="col-sm-8 mb-2 text-success fw-bold">
                    @(Model.LoaiPhuongTien?.TenLoaiPhuongTien ?? Model.MaLoaiPhuongTien.ToString())
                </dd>

                <dt class="col-sm-4 fw-bold mb-2">Chủ phương tiện:</dt>
                <dd class="col-sm-8 mb-2 fw-bold text-dark">
                    @(Model.ChuPhuongTien?.HoTen ?? Model.MaChuPhuongTien.ToString())
                    @if (Model.ChuPhuongTien != null)
                    {
                        <span class="text-muted fw-normal">(@Model.ChuPhuongTien.SoDienThoai)</span>
                    }
                </dd>

                <hr class="my-2" />

                <dt class="col-sm-4 fw-bold mb-2">Nhãn hiệu:</dt>
                <dd class="col-sm-8 mb-2">@(string.IsNullOrEmpty(Model.NhanHieu) ? "Chưa cập nhật" : Model.NhanHieu)</dd>

                <dt class="col-sm-4 fw-bold mb-2">Màu sắc:</dt>
                <dd class="col-sm-8 mb-2">@(string.IsNullOrEmpty(Model.MauSac) ? "Chưa cập nhật" : Model.MauSac)</dd>

                <dt class="col-sm-4 fw-bold mb-2">Mô tả:</dt>
                <dd class="col-sm-8 mb-2">@(string.IsNullOrEmpty(Model.MoTa) ? "Không có ghi chú" : Model.MoTa)</dd>

                <dt class="col-sm-4 fw-bold mb-2">Trạng thái xe:</dt>
                <dd class="col-sm-8 mb-2">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success px-3 py-2">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">Tạm ngừng</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer text-center bg-light py-3">
            <a asp-action="Index" class="btn btn-secondary me-2">
                Quay lại danh sách
            </a>
            <a asp-action="Edit" asp-route-id="@Model.MaPhuongTien" class="btn btn-warning fw-bold">
                Chỉnh sửa thông tin
            </a>
        </div>
    </div>
</div>