@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 3 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhuongTien
@{ ViewData["Title"] = "Chi tiết phương tiện"; }
<h2 class="text-primary fw-bold mb-3">Chi tiết phương tiện</h2>
<div class="card shadow-sm mb-3"><div class="card-body"><dl class="row mb-0">
    <dt class="col-sm-3">Biển số</dt><dd class="col-sm-9 fw-bold">@Model.BienSoXe</dd>
    <dt class="col-sm-3">Chủ phương tiện</dt><dd class="col-sm-9">@Model.ChuPhuongTien?.HoTen</dd>
    <dt class="col-sm-3">Loại phương tiện</dt><dd class="col-sm-9">@Model.LoaiPhuongTien?.TenLoaiPhuongTien (@Model.LoaiPhuongTien?.DonGiaTheoGio.ToString("N0") VNĐ/giờ)</dd>
    <dt class="col-sm-3">Nhãn hiệu</dt><dd class="col-sm-9">@Model.NhanHieu</dd>
    <dt class="col-sm-3">Màu sắc</dt><dd class="col-sm-9">@Model.MauSac</dd>
    <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.MoTa</dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@(Model.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")</dd>
</dl></div></div>
<a asp-action="Edit" asp-route-id="@Model.MaPhuongTien" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">← Danh sách</a>
