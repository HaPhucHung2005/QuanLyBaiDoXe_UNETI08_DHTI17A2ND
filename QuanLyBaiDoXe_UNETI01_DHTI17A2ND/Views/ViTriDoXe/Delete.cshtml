@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Module 2 - Giao diện Xác nhận xóa vị trí đỗ xe
*@

@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.ViTriDoXe

@{
    ViewData["Title"] = "Xác Nhận Xóa Vị Trí Đỗ Xe";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-danger rounded-3">
                <div class="card-header bg-danger text-white fw-bold py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA VỊ TRÍ ĐỖ XE</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 mb-3 small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa vị trí đỗ xe này khỏi hệ thống? Hành động này không thể hoàn tác.
                    </div>

                    @if (Model != null)
                    {
                        <dl class="row mb-0 align-items-center fs-6">
                            <dt class="col-sm-4 text-muted">Mã vị trí:</dt>
                            <dd class="col-sm-8 fw-bold">#@Model.MaViTri</dd>

                            <dt class="col-sm-4 text-muted">Tên vị trí:</dt>
                            <dd class="col-sm-8 fw-bold text-danger">@Model.TenViTri</dd>

                            <dt class="col-sm-4 text-muted">Khu vực / Tầng:</dt>
                            <dd class="col-sm-8">@Model.KhuVuc - Tầng @Model.Tang</dd>

                            <dt class="col-sm-4 text-muted">Loại xe áp dụng:</dt>
                            <dd class="col-sm-8 text-primary fw-bold">
                                @(Model.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Chưa phân loại")
                            </dd>

                            <dt class="col-sm-4 text-muted">Đơn giá / giờ:</dt>
                            <dd class="col-sm-8 text-success fw-bold">
                                @(Model.LoaiPhuongTien != null ? Model.LoaiPhuongTien.DonGiaTheoGio.ToString("N0") + " VNĐ" : "-")
                            </dd>

                            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                            <dd class="col-sm-8">
                                @if (Model.TrangThai == TrangThaiViTri.ConTrong)
                                {
                                    <span class="badge bg-success px-2 py-1">Còn trống</span>
                                }
                                else if (Model.TrangThai == TrangThaiViTri.DangSuDung)
                                {
                                    <span class="badge bg-danger px-2 py-1">Đang sử dụng</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">@Model.TrangThai</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted">Mô tả ghi chú:</dt>
                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có ghi chú" : Model.MoTa)
                            </dd>
                        </dl>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center mb-0">
                            Không tìm thấy thông tin vị trí đỗ xe.
                        </div>
                    }
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">
                        ← Hủy bỏ & Quay lại
                    </a>
                    @if (Model != null)
                    {
                        <form asp-action="Delete" method="post" class="m-0">
                            <input type="hidden" asp-for="MaViTri" />
                            <button type="submit" class="btn btn-danger px-4 fw-bold">
                                🗑️ Xác Nhận Xóa
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>