@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Module 2 - Giao diện Thêm mới Vị trí đỗ xe
*@

@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.ViTriDoXe

@{
    ViewData["Title"] = "Thêm Vị Trí Đỗ Xe Mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-plus-circle-fill me-2"></i>THÊM MỚI VỊ TRÍ ĐỖ XE</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenViTri" class="form-label fw-bold small">Tên vị trí</label>
                                <input asp-for="TenViTri" class="form-control" placeholder="vd: A01, B02..." />
                                <span asp-validation-for="TenViTri" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="KhuVuc" class="form-label fw-bold small">Khu vực</label>
                                <input asp-for="KhuVuc" class="form-control" placeholder="vd: Khu A, Khu B..." />
                                <span asp-validation-for="KhuVuc" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Tang" class="form-label fw-bold small">Tầng đỗ xe</label>
                                <input asp-for="Tang" class="form-control" type="number" min="1" max="100" />
                                <span asp-validation-for="Tang" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaLoaiPhuongTien" class="form-label fw-bold small">Loại xe áp dụng</label>
                                <select asp-for="MaLoaiPhuongTien" class="form-select" asp-items="ViewBag.MaLoaiPhuongTien">
                                    <option value="">-- Chọn loại phương tiện --</option>
                                </select>
                                <span asp-validation-for="MaLoaiPhuongTien" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TrangThai" class="form-label fw-bold small">Trạng thái khởi tạo</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="@TrangThaiViTri.ConTrong">@TrangThaiViTri.ConTrong</option>
                                <option value="@TrangThaiViTri.DangSuDung">@TrangThaiViTri.DangSuDung</option>
                                <option value="@TrangThaiViTri.TamNgung">@TrangThaiViTri.TamNgung</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold small">Mô tả ghi chú</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Ghi chú thêm về vị trí đỗ (ví dụ: Gần thang máy, có mái che)..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                                ← Quay lại
                            </a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">
                                ➕ Tạo Mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}