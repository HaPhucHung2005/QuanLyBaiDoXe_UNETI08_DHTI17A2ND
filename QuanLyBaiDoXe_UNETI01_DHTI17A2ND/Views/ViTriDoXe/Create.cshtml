@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.ViTriDoXe

@{
    ViewData["Title"] = "Thêm Vị Trí Đỗ Xe Mới";
}

<div class="row justify-content-center">
    <div class="col-md-6 card p-4 shadow-sm border-0 rounded-3">
        <h3 class="text-primary fw-bold text-center mb-3">THÊM MỚI VỊ TRÍ ĐỖ XE</h3>
        <hr />

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TenViTri" class="form-label fw-bold"></label>
                <input asp-for="TenViTri" class="form-control" placeholder="Nhập tên vị trí (vd: A-01, B-02)..." />
                <span asp-validation-for="TenViTri" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="KhuVuc" class="form-label fw-bold"></label>
                <input asp-for="KhuVuc" class="form-control" placeholder="Nhập khu vực (vd: Khu A, Khu B)..." />
                <span asp-validation-for="KhuVuc" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tang" class="form-label fw-bold"></label>
                <input asp-for="Tang" class="form-control" type="number" min="1" value="1" />
                <span asp-validation-for="Tang" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaLoaiPhuongTien" class="form-label fw-bold">Loại Xe Khả Dụng</label>
                <select asp-for="MaLoaiPhuongTien" class="form-select" asp-items="ViewBag.MaLoaiPhuongTien">
                    <option value="">-- Chọn loại phương tiện --</option>
                </select>
                <span asp-validation-for="MaLoaiPhuongTien" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label fw-bold"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="Còn trống" selected>Còn trống</option>
                    <option value="Đang sử dụng">Đang sử dụng</option>
                    <option value="Tạm ngừng">Tạm ngừng</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label fw-bold"></label>
                <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả ghi chú vị trí..."></textarea>
                <span asp-validation-for="MoTa" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                <button type="submit" class="btn btn-success fw-bold px-4">+ Tạo Mới</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}