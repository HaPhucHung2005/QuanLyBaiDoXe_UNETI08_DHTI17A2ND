@using Microsoft.AspNetCore.Http
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.ViTriDoXe

@{
    ViewData["Title"] = "Chi Tiết Vị Trí Đỗ Xe";
    bool isAdmin = Context.Session.GetString("VaiTro") == "Admin";
}

<div class="row justify-content-center">
    <div class="col-md-8 card p-4 shadow-sm border-0 rounded-3">
        <h3 class="text-primary fw-bold mb-3">CHI TIẾT VỊ TRÍ ĐỖ XE</h3>
        <hr />

        @if (Model != null)
        {
            <dl class="row fs-6">
                <dt class="col-sm-4 text-muted">Tên Vị Trí:</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model.TenViTri</dd>

                <dt class="col-sm-4 text-muted">Khu Vực:</dt>
                <dd class="col-sm-8">@Model.KhuVuc</dd>

                <dt class="col-sm-4 text-muted">Tầng:</dt>
                <dd class="col-sm-8">Tầng @Model.Tang</dd>

                <dt class="col-sm-4 text-muted">Loại Xe Khả Dụng:</dt>
                <dd class="col-sm-8 text-info fw-bold">
                    @(Model.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Chưa phân loại")
                </dd>

                <dt class="col-sm-4 text-muted">Đơn Giá / Giờ:</dt>
                <dd class="col-sm-8 text-success fw-bold">
                    @(Model.LoaiPhuongTien != null ? Model.LoaiPhuongTien.DonGiaTheoGio.ToString("N0") + " VNĐ" : "-")
                </dd>

                <dt class="col-sm-4 text-muted">Trạng Thái:</dt>
                <dd class="col-sm-8">
                    @if (Model.TrangThai == "Còn trống")
                    {
                        <span class="badge bg-success">Còn trống</span>
                    }
                    else if (Model.TrangThai == "Đang sử dụng")
                    {
                        <span class="badge bg-danger">Đang sử dụng</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.TrangThai</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">Mô Tả Ghi Chú:</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có ghi chú" : Model.MoTa)
                </dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaViTri" class="btn btn-warning fw-bold px-4">Chỉnh Sửa</a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                Không tìm thấy thông tin vị trí đỗ xe.
            </div>
            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
            </div>
        }
    </div>
</div>