@*
    Họ và tên: Hà Phúc Hưng - Trần Ngọc Minh
    Mã sinh viên: 23203100001 - [MSSV]
    Nội dung thực hiện: Giao diện Trang chủ Dashboard dành cho Khách hàng (Module 1 - 4)
*@

@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang Chủ - Quản Lý Bãi Đỗ Xe UNETI";
    var hoTen = Context.Session.GetString("HoTen") ?? "Khách hàng";
}

<div class="container mt-3">
    <!-- Hiển thị thông báo TempData nếu có -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Loi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Banner chào mừng -->
    <div class="p-5 mb-4 bg-primary text-white rounded-3 shadow-sm">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">👋 Xin chào, @hoTen!</h1>
            <p class="col-md-9 fs-5">
                Chào mừng bạn đến với <strong>Hệ Thống Quản Lý & Đăng Ký Gửi Xe UNETI</strong>. 
                Bạn có thể dễ dàng tra cứu vị trí đỗ còn trống, quản lý danh sách phương tiện và đăng ký gửi xe nhanh chóng ngay tại đây.
            </p>
            <div class="d-flex gap-3 mt-4">
                <a asp-controller="PhieuGuiXe" asp-action="Create" class="btn btn-warning btn-lg fw-bold text-dark px-4 shadow">
                    <i class="bi bi-plus-circle-fill me-2"></i>Đăng Ký Gửi Xe Ngay
                </a>
                <a asp-controller="ViTriDoXe" asp-action="Index" class="btn btn-outline-light btn-lg px-4 fw-semibold">
                    <i class="bi bi-search me-2"></i>Tra Cứu Vị Trí Đỗ
                </a>
            </div>
        </div>
    </div>

    <!-- Phím tắt truy cập nhanh -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary rounded-3">
                <div class="card-body text-center p-4">
                    <div class="fs-1 text-primary mb-2"><i class="bi bi-car-front-fill"></i></div>
                    <h5 class="card-title fw-bold">Phương Tiện Của Tôi</h5>
                    <p class="card-text text-muted small">Xem danh sách xe đã đăng ký, cập nhật nhãn hiệu, màu sắc hoặc đăng ký xe mới vào hệ thống.</p>
                    <a asp-controller="PhuongTien" asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold px-3">
                        Xem Danh Sách Xe →
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-success rounded-3">
                <div class="card-body text-center p-4">
                    <div class="fs-1 text-success mb-2"><i class="bi bi-receipt-cutoff"></i></div>
                    <h5 class="card-title fw-bold">Lịch Sử Gửi Xe</h5>
                    <p class="card-text text-muted small">Theo dõi chi tiết các lượt gửi xe đang hoạt động, phiếu chờ xác nhận và lịch sử các lần đỗ xe trước đây.</p>
                    <a asp-controller="PhieuGuiXe" asp-action="Index" class="btn btn-outline-success btn-sm fw-bold px-3">
                        Xem Lịch Sử Gửi →
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-info rounded-3">
                <div class="card-body text-center p-4">
                    <div class="fs-1 text-info mb-2"><i class="bi bi-person-bounding-box"></i></div>
                    <h5 class="card-title fw-bold">Hồ Sơ Của Tôi</h5>
                    <p class="card-text text-muted small">Cập nhật thông tin cá nhân, số điện thoại liên hệ, ngày sinh và địa chỉ cư trú của chủ xe.</p>
                    <a asp-controller="ChuPhuongTien" asp-action="Details" class="btn btn-outline-info btn-sm fw-bold px-3">
                        Xem Thông Tin Hồ Sơ →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
