@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 3 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.ChuPhuongTien
@{
    ViewData["Title"] = "Chi tiết chủ phương tiện";
    bool isAdmin = Context.Session.GetString("VaiTro") == "Admin";
}
<h2 class="text-primary fw-bold mb-3">Thông tin chủ phương tiện</h2>
<div class="card shadow-sm mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
        <dt class="col-sm-3">Tài khoản</dt><dd class="col-sm-9">@Model.TaiKhoan?.TenDangNhap</dd>
        <dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Giới tính</dt><dd class="col-sm-9">@Model.GioiTinh</dd>
        <dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.SoDienThoai</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@Model.DiaChi</dd>
        <dt class="col-sm-3">Ngày đăng ký</dt><dd class="col-sm-9">@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@(Model.TrangThai ? "Đang hoạt động" : "Đã khóa")</dd>
    </dl>
</div></div>
<h5>Phương tiện (@(Model.DanhSachPhuongTien?.Count ?? 0))</h5>
<table class="table table-sm table-bordered bg-white">
    <thead class="table-light"><tr><th>Biển số</th><th>Loại</th><th>Nhãn hiệu</th><th>Màu</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var p in Model.DanhSachPhuongTien ?? new List<QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhuongTien>())
    {
        <tr><td>@p.BienSoXe</td><td>@p.LoaiPhuongTien?.TenLoaiPhuongTien</td><td>@p.NhanHieu</td><td>@p.MauSac</td><td>@(p.TrangThai ? "Hoạt động" : "Ngừng")</td></tr>
    }
    </tbody>
</table>
@if (isAdmin) { <a asp-action="Index" class="btn btn-secondary">← Danh sách</a> }
else { <a asp-action="ThongTinCaNhan" class="btn btn-primary">Cập nhật thông tin</a> }
