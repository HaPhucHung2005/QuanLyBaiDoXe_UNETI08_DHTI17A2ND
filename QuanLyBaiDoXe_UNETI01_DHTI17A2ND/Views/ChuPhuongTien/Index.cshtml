@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 3 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.ChuPhuongTienFilterViewModel
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels
@{
    ViewData["Title"] = "Quản Lý Chủ Phương Tiện";
    var pt = new PhanTrangViewModel
    {
        Action = "Index", PageIndex = Model.PageIndex, TotalPages = Model.TotalPages,
        RouteValues = new() { ["search"] = Model.Search, ["trangThai"] = Model.TrangThai, ["sortOrder"] = Model.SortOrder }
    };
}
<h2 class="text-primary fw-bold mb-3">👤 QUẢN LÝ CHỦ PHƯƠNG TIỆN</h2>
<div class="card p-3 mb-3 bg-light border-0 shadow-sm">
    <form asp-action="Index" method="get" class="row g-2">
        <div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="Họ tên, SĐT hoặc email..." /></div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.TrangThai))">-- Tất cả trạng thái --</option>
                <option value="hoatdong" selected="@(Model.TrangThai == "hoatdong")">Đang hoạt động</option>
                <option value="khoa" selected="@(Model.TrangThai == "khoa")">Đã khóa</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sortOrder" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Tên A-Z</option>
                <option value="ten_desc" selected="@(Model.SortOrder == "ten_desc")">Tên Z-A</option>
                <option value="ngay_desc" selected="@(Model.SortOrder == "ngay_desc")">Đăng ký mới nhất</option>
                <option value="ngay_asc" selected="@(Model.SortOrder == "ngay_asc")">Đăng ký cũ nhất</option>
            </select>
        </div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary fw-bold">🔍 Tìm</button></div>
    </form>
</div>
<table class="table table-bordered table-hover align-middle bg-white shadow-sm">
    <thead class="table-primary text-center">
        <tr><th>Họ tên</th><th>Ngày sinh</th><th>Giới tính</th><th>SĐT</th><th>Email</th><th>Số xe</th><th>Ngày đăng ký</th><th>Trạng thái</th><th>Thao tác</th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model.DanhSach)
    {
        <tr>
            <td class="fw-semibold">@c.HoTen</td>
            <td class="text-center">@c.NgaySinh.ToString("dd/MM/yyyy")</td>
            <td class="text-center">@c.GioiTinh</td>
            <td>@c.SoDienThoai</td>
            <td>@c.Email</td>
            <td class="text-center">@(c.DanhSachPhuongTien?.Count ?? 0)</td>
            <td class="text-center">@c.NgayDangKy.ToString("dd/MM/yyyy")</td>
            <td class="text-center">@if (c.TrangThai) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-danger">Đã khóa</span> }</td>
            <td class="text-center">
                <a asp-action="Details" asp-route-id="@c.MaChuPhuongTien" class="btn btn-sm btn-outline-info">Xem</a>
                <form asp-action="CapNhatTrangThai" asp-route-id="@c.MaChuPhuongTien" method="post" class="d-inline">
                    <button class="btn btn-sm @(c.TrangThai ? "btn-outline-danger" : "btn-outline-success")" onclick="return confirm('Đổi trạng thái chủ phương tiện này?');">@(c.TrangThai ? "Khóa" : "Mở khóa")</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.DanhSach.Any()) { <tr><td colspan="9" class="text-center text-muted py-3">Không có chủ phương tiện phù hợp.</td></tr> }
    </tbody>
</table>
<partial name="_PhanTrang" model="pt" />
