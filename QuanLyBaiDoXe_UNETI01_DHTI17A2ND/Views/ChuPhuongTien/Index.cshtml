@*
    Họ và tên: Hà Phúc Hưng - Trần Ngọc Minh
    Mã sinh viên: 23203100001 - MSSV
    Nội dung thực hiện: Giao diện Quản lý danh sách Chủ phương tiện (Module 3)
*@

@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.ChuPhuongTienFilterViewModel

@{
    ViewData["Title"] = "Quản Lý Chủ Phương Tiện";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-person-lines-fill"></i> Quản Lý Chủ Phương Tiện
        </h2>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-person-plus"></i> Thêm Chủ Phương Tiện Mới
        </a>
    </div>

    @* Thông báo từ TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Khung tìm kiếm và bộ lọc trạng thái (Mục 7.1) *@
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <div class="input-group">
                <input type="text" name="keyword" value="@Model.Search" class="form-control" placeholder="Nhập họ tên, số điện thoại hoặc email..." />
                <button type="submit" class="btn btn-primary fw-bold">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="hoatdong" selected="@(Model.TrangThai == "hoatdong")">Đang hoạt động</option>
                <option value="khoa" selected="@(Model.TrangThai == "khoa")">Đã khóa</option>
            </select>
        </div>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.TrangThai))
        {
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa bộ lọc</a>
            </div>
        }
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Tên đăng nhập</th>
                            <th>Họ và tên</th>
                            <th>Ngày sinh</th>
                            <th>Giới tính</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Địa chỉ</th>
                            <th>Ngày đăng ký</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach != null && Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-primary">
                                        @(item.TaiKhoan?.TenDangNhap ?? item.MaTaiKhoan.ToString())
                                    </td>
                                    <td class="fw-bold">@item.HoTen</td>
                                    <td class="text-center">
                                        @(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.GioiTinh == "Nam" || item.GioiTinh == "True" || item.GioiTinh == "true")
                                        {
                                            <span>Nam</span>
                                        }
                                        else
                                        {
                                            <span>Nữ</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.SoDienThoai</td>
                                    <td>@(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)</td>
                                    <td>@(string.IsNullOrEmpty(item.DiaChi) ? "-" : item.DiaChi)</td>
                                    <td class="text-center">@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (item.TrangThai == TrangThaiTaiKhoan.DangHoatDong)
                                        {
                                            <span class="badge bg-success px-2 py-1">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2 py-1">Đã khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaChuPhuongTien" class="btn btn-outline-info" title="Xem chi tiết">
                                                Xem
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaChuPhuongTien" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaChuPhuongTien" class="btn btn-outline-danger" title="Xóa">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    Không tìm thấy chủ phương tiện nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>