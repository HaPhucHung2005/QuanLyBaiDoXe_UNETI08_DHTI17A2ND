@* Họ và tên: Hà Phúc Hưng - Mã SV: 23203100001 *@
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Bãi Đỗ Xe UNETI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyBaiDoXe_UNETI01_DHTI17A2ND.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="ViTriDoXe" asp-action="Index">🚗 QUẢN LÝ BÃI ĐỖ XE UNETI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("VaiTro") == "Admin")
                            {
                            <!-- Menu dành cho Quản trị viên (Admin) -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="LoaiPhuongTien" asp-action="Index">Quản Lý Loại Xe</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="ViTriDoXe" asp-action="Index">Quản Lý Vị Trí Đỗ</a>
                            </li>
                            <!-- Module 3 & 4 -->
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="ChuPhuongTien" asp-action="Index">Chủ Phương Tiện</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="PhuongTien" asp-action="Index">Phương Tiện</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="PhieuGuiXe" asp-action="Index">Phiếu Gửi Xe</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="ThongKe" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="ThongKe" asp-action="ThongKe">Thống Kê</a></li>
                            }
                        else if (Context.Session.GetString("MaTaiKhoan") != null)
                            {
                            <!-- Menu dành cho Khách hàng đã đăng nhập -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="ViTriDoXe" asp-action="Index">Tra Cứu Vị Trí Đỗ</a>
                            </li>
                            <!-- Module 3 -->
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="PhuongTien" asp-action="Index">Phương Tiện Của Tôi</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="DangKyGuiXe" asp-action="DangKy">Đăng Ký Gửi Xe</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="DangKyGuiXe" asp-action="LichSu">Phiếu & Lịch Sử</a></li>
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="ChuPhuongTien" asp-action="ThongTinCaNhan">Thông Tin Cá Nhân</a></li>
                            }
                    </ul>

                    <!-- Khối thông tin Tài khoản & Đăng xuất / Đăng nhập -->
                    <ul class="navbar-nav">
                            @if (Context.Session.GetString("MaTaiKhoan") != null)
                            {
                            <li class="nav-item d-flex align-items-center me-3 text-white">
                                <span>Xin chào, <strong class="text-warning">@Context.Session.GetString("HoTen")</strong> (@Context.Session.GetString("VaiTro"))</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm fw-bold" asp-controller="TaiKhoan" asp-action="Logout">Đăng Xuất</a>
                            </li>
                            }
                            else
                            {
                            <li class="nav-item">
                                <a class="btn btn-light text-primary btn-sm fw-bold" asp-controller="TaiKhoan" asp-action="Login">Đăng Nhập</a>
                            </li>
                            }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["ThongBao"] is string tbOk)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">@tbOk<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Loi"] is string tbLoi)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@tbLoi<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Hệ Thống Quản Lý Bãi Đỗ Xe - UNETI - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
