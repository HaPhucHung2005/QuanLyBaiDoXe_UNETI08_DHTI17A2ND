@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.PhanTrangViewModel
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.Route(Model.PageIndex - 1)">&laquo; Trước</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.Route(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.Route(Model.PageIndex + 1)">Sau &raquo;</a>
            </li>
        </ul>
        <div class="text-center text-muted small">Trang @Model.PageIndex / @Model.TotalPages</div>
    </nav>
}
