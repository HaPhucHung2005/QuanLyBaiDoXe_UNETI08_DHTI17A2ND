@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 3 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.DangKyGuiXeViewModel
@{ ViewData["Title"] = "Đăng ký gửi xe"; }
<h2 class="text-primary fw-bold mb-3">📝 ĐĂNG KÝ GỬI XE</h2>
@if (!Model.DanhSachPhuongTien.Any())
{
    <div class="alert alert-warning">Bạn chưa có phương tiện đang hoạt động. <a asp-controller="PhuongTien" asp-action="Create">Thêm phương tiện</a> trước khi đăng ký.</div>
}
<form asp-action="DangKy" method="post" class="card p-4 shadow-sm col-md-8">
    <div asp-validation-summary="All" class="alert alert-danger py-2 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
    <div class="mb-3">
        <label asp-for="MaPhuongTien" class="form-label"></label>
        <select asp-for="MaPhuongTien" id="selPhuongTien" class="form-select">
            <option value="">-- Chọn phương tiện của bạn --</option>
            @foreach (var p in Model.DanhSachPhuongTien)
            {
                <option value="@p.MaPhuongTien" data-loai="@p.MaLoaiPhuongTien" selected="@(p.MaPhuongTien == Model.MaPhuongTien)">@p.BienSoXe - @p.LoaiPhuongTien?.TenLoaiPhuongTien</option>
            }
        </select>
        <span asp-validation-for="MaPhuongTien" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaViTri" class="form-label"></label>
        <select asp-for="MaViTri" id="selViTri" class="form-select">
            <option value="">-- Chọn vị trí đỗ --</option>
            @foreach (var v in Model.DanhSachViTri)
            {
                <option value="@v.MaViTri" data-loai="@v.MaLoaiPhuongTien" selected="@(v.MaViTri == Model.MaViTri)">@v.TenViTri - @v.KhuVuc, tầng @v.Tang (@v.LoaiPhuongTien?.TenLoaiPhuongTien - @v.LoaiPhuongTien?.DonGiaTheoGio.ToString("N0") VNĐ/giờ)</option>
            }
        </select>
        <div class="form-text">Chỉ hiển thị vị trí phù hợp với loại phương tiện đã chọn. Đơn giá do hệ thống tự áp dụng.</div>
        <span asp-validation-for="MaViTri" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="ThoiGianDuKienVao" class="form-label"></label><input asp-for="ThoiGianDuKienVao" type="datetime-local" class="form-control" /><span asp-validation-for="ThoiGianDuKienVao" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="ThoiGianDuKienRa" class="form-label"></label><input asp-for="ThoiGianDuKienRa" type="datetime-local" class="form-control" /><span asp-validation-for="ThoiGianDuKienRa" class="text-danger"></span></div>
    </div>
    <div><button class="btn btn-success fw-bold">Đăng ký</button> <a asp-controller="ViTriDoXe" asp-action="Index" class="btn btn-secondary">Xem vị trí đỗ</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Lọc danh sách vị trí theo loại phương tiện đã chọn (server vẫn kiểm tra lại)
        const selPt = document.getElementById('selPhuongTien');
        const selVt = document.getElementById('selViTri');
        function locViTri() {
            const opt = selPt.options[selPt.selectedIndex];
            const loai = opt ? opt.getAttribute('data-loai') : null;
            for (const o of selVt.options) {
                if (!o.value) continue;
                const hop = !loai || o.getAttribute('data-loai') === loai;
                o.hidden = !hop; o.disabled = !hop;
            }
            const cur = selVt.options[selVt.selectedIndex];
            if (cur && cur.disabled) selVt.value = '';
        }
        selPt.addEventListener('change', locViTri);
        locViTri();
    </script>
}
