@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 3 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.LichSuGuiXeViewModel
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@{
    ViewData["Title"] = "Phiếu gửi xe & lịch sử";
    var pt = new PhanTrangViewModel { Action = "LichSu", PageIndex = Model.PageIndex, TotalPages = Model.TotalPages,
        RouteValues = new() { ["trangThai"] = Model.TrangThai } };
    int Dem(string k) => Model.SoLuongTheoTrangThai.TryGetValue(k, out var n) ? n : 0;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary fw-bold">📜 PHIẾU GỬI XE & LỊCH SỬ</h2>
    <a asp-action="DangKy" class="btn btn-success fw-bold">+ Đăng ký gửi xe</a>
</div>
<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(string.IsNullOrEmpty(Model.TrangThai) ? "active" : "")" asp-action="LichSu">Tất cả (@Model.SoLuongTheoTrangThai.Values.Sum())</a></li>
    @foreach (var tt in TrangThaiPhieu.TatCa)
    {
        <li class="nav-item"><a class="nav-link @(Model.TrangThai == tt ? "active" : "")" asp-action="LichSu" asp-route-trangThai="@tt">@tt (@Dem(tt))</a></li>
    }
</ul>
<table class="table table-bordered table-hover align-middle bg-white shadow-sm">
    <thead class="table-primary text-center"><tr><th>Mã</th><th>Biển số</th><th>Vị trí</th><th>Dự kiến vào</th><th>Dự kiến ra</th><th>Thành tiền</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.DanhSach)
    {
        <tr>
            <td class="text-center">#@p.MaPhieu</td>
            <td class="fw-bold">@p.PhuongTien?.BienSoXe</td>
            <td class="text-center">@p.ViTriDoXe?.TenViTri (@p.ViTriDoXe?.KhuVuc)</td>
            <td class="text-center">@p.ThoiGianDuKienVao.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-center">@p.ThoiGianDuKienRa.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">@(p.ThanhTien.HasValue ? p.ThanhTien.Value.ToString("N0") + " VNĐ" : "—")</td>
            <td class="text-center"><partial name="_TrangThaiPhieuBadge" model="p.TrangThai" /></td>
            <td class="text-center"><a asp-action="ChiTiet" asp-route-id="@p.MaPhieu" class="btn btn-sm btn-outline-info">Chi tiết</a></td>
        </tr>
    }
    @if (!Model.DanhSach.Any()) { <tr><td colspan="8" class="text-center text-muted py-3">Chưa có phiếu gửi xe nào.</td></tr> }
    </tbody>
</table>
<partial name="_PhanTrang" model="pt" />
