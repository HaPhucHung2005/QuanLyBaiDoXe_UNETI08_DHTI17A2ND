@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.LoginViewModel;

@* Họ và tên: Hà Phúc Hưng - Mã SV: 23203100001 *@
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4 card p-4 shadow-sm">
        <h3 class="text-center mb-4 text-primary">ĐĂNG NHẬP HỆ THỐNG</h3>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập..." />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MatKhau" class="form-label"></label>
                <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Đăng Nhập</button>
        </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}