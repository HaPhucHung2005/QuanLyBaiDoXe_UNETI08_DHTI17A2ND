@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 4 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var the = new (string Nhan, int So, string Mau)[] {
        ("Loại phương tiện", Model.TongLoaiPhuongTien, "primary"), ("Vị trí đỗ", Model.TongViTri, "primary"),
        ("Chủ phương tiện", Model.TongChuPhuongTien, "primary"), ("Phương tiện", Model.TongPhuongTien, "primary"),
        ("Tổng phiếu gửi xe", Model.TongPhieu, "dark"), ("Phiếu chờ xác nhận", Model.PhieuChoXacNhan, "warning"),
        ("Xe đang gửi", Model.XeDangGui, "info"), ("Vị trí còn trống", Model.ViTriConTrong, "success"),
        ("Vị trí đang sử dụng", Model.ViTriDangSuDung, "danger") };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary fw-bold">📊 DASHBOARD</h2>
    <a asp-action="ThongKe" class="btn btn-outline-primary">Xem thống kê chi tiết →</a>
</div>
<div class="row g-3">
@foreach (var t in the)
{
    <div class="col-6 col-md-4">
        <div class="card border-@t.Mau shadow-sm h-100"><div class="card-body text-center">
            <div class="display-5 fw-bold text-@t.Mau">@t.So</div>
            <div class="text-muted">@t.Nhan</div>
        </div></div>
    </div>
}
</div>
