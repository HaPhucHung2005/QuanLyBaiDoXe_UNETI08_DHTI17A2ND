@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 4 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.ThongKeViewModel
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels
@{ ViewData["Title"] = "Thống kê"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary fw-bold">📈 THỐNG KÊ</h2>
    <a asp-action="Index" class="btn btn-outline-primary">← Dashboard</a>
</div>
<p class="text-muted">"Lượt gửi" tính các phiếu đã có xe vào bãi (Đang gửi + Đã lấy xe).</p>
<div class="row g-3 mb-3">
    <div class="col-md-4"><partial name="_Bang" model="@(new ThongKeBang("Số phương tiện theo loại", Model.PhuongTienTheoLoai))" /></div>
    <div class="col-md-4"><partial name="_Bang" model="@(new ThongKeBang("Số vị trí theo trạng thái", Model.ViTriTheoTrangThai))" /></div>
    <div class="col-md-4"><partial name="_Bang" model="@(new ThongKeBang("Số phiếu theo trạng thái", Model.PhieuTheoTrangThai))" /></div>
    <div class="col-md-4"><partial name="_Bang" model="@(new ThongKeBang("Lượt gửi theo loại phương tiện", Model.LuotGuiTheoLoai))" /></div>
    <div class="col-md-4"><partial name="_Bang" model="@(new ThongKeBang("Lượt gửi theo tháng", Model.LuotGuiTheoThang))" /></div>
    <div class="col-md-4"><partial name="_Bang" model="@(new ThongKeBang("Vị trí được sử dụng nhiều nhất", Model.ViTriNhieuNhat))" /></div>
    <div class="col-md-6"><partial name="_Bang" model="@(new ThongKeBang("Lượt gửi theo vị trí", Model.LuotGuiTheoViTri))" /></div>
    <div class="col-md-6"><partial name="_Bang" model="@(new ThongKeBang("Lượt gửi theo chủ phương tiện", Model.LuotGuiTheoChu))" /></div>
</div>
<div class="card shadow-sm"><div class="card-header fw-bold bg-success text-white">Doanh thu theo tháng (phiếu Đã lấy xe)</div>
<div class="card-body p-2">
    <table class="table table-sm table-bordered mb-0">
        <thead class="table-light"><tr><th>Tháng</th><th class="text-end">Số phiếu</th><th class="text-end">Doanh thu (VNĐ)</th></tr></thead>
        <tbody>
        @foreach (var d in Model.DoanhThuTheoThang)
        {
            <tr><td>@d.Thang</td><td class="text-end">@d.SoPhieu</td><td class="text-end">@d.DoanhThu.ToString("N0")</td></tr>
        }
        <tr class="fw-bold table-success"><td colspan="2">Tổng cộng</td><td class="text-end">@Model.TongDoanhThu.ToString("N0")</td></tr>
        </tbody>
    </table>
</div></div>
