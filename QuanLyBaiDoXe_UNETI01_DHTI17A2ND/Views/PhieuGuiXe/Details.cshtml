@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 4 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhieuGuiXe
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@{ ViewData["Title"] = "Chi tiết phiếu gửi xe"; }
<h2 class="text-primary fw-bold mb-3">Chi tiết phiếu gửi xe #@Model.MaPhieu</h2>
<partial name="_ChiTietPhieu" model="Model" />
<div class="d-flex gap-2">
    @if (Model.TrangThai == TrangThaiPhieu.ChoXacNhan)
    {
        <form asp-action="XacNhanVao" asp-route-id="@Model.MaPhieu" method="post"><button class="btn btn-primary" onclick="return confirm('Xác nhận xe vào bãi?');">✅ Xác nhận xe vào</button></form>
        <form asp-action="Huy" asp-route-id="@Model.MaPhieu" method="post"><button class="btn btn-outline-danger" onclick="return confirm('Hủy phiếu này?');">Hủy phiếu</button></form>
    }
    else if (Model.TrangThai == TrangThaiPhieu.DangGui)
    {
        <form asp-action="XacNhanRa" asp-route-id="@Model.MaPhieu" method="post"><button class="btn btn-success" onclick="return confirm('Xác nhận xe ra và tính phí?');">🚪 Xác nhận xe ra & tính phí</button></form>
    }
    <a asp-action="Index" class="btn btn-secondary">← Danh sách</a>
</div>
