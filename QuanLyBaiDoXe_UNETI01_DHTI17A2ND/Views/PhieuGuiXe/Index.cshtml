@*
    Họ và tên: Hà Phúc Hưng - Trần Ngọc Minh
    Mã sinh viên: 23203100001 - MSSV
    Nội dung thực hiện: Giao diện Danh sách và Lịch sử Phiếu gửi xe (Module 3)
*@

@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.LichSuGuiXeViewModel

@{
    ViewData["Title"] = "Danh Sách Phiếu Gửi Xe";
    var currentTrangThai = Model.TrangThai;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-receipt"></i> Lịch Sử & Danh Sách Phiếu Gửi Xe
        </h2>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle"></i> Đăng Ký Gửi Xe Mới
        </a>
    </div>

    @* Thông báo thành công / lỗi từ TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Bộ lọc trạng thái phiếu gửi xe với số lượng thống kê *@
    <div class="btn-group mb-3 flex-wrap" role="group">
        <a asp-action="Index" class="btn btn-outline-primary @(string.IsNullOrEmpty(currentTrangThai) ? "active" : "")">
            Tất cả
        </a>
        <a asp-action="Index" asp-route-trangThai="@TrangThaiPhieu.ChoXacNhan" class="btn btn-outline-warning @(currentTrangThai == TrangThaiPhieu.ChoXacNhan ? "active" : "")">
            @TrangThaiPhieu.ChoXacNhan
            @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiPhieu.ChoXacNhan))
            {
                <span class="badge bg-warning text-dark ms-1">@Model.SoLuongTheoTrangThai[TrangThaiPhieu.ChoXacNhan]</span>
            }
        </a>
        <a asp-action="Index" asp-route-trangThai="@TrangThaiPhieu.DangGui" class="btn btn-outline-info @(currentTrangThai == TrangThaiPhieu.DangGui ? "active" : "")">
            @TrangThaiPhieu.DangGui
            @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiPhieu.DangGui))
            {
                <span class="badge bg-info text-white ms-1">@Model.SoLuongTheoTrangThai[TrangThaiPhieu.DangGui]</span>
            }
        </a>
        <a asp-action="Index" asp-route-trangThai="@TrangThaiPhieu.DaLayXe" class="btn btn-outline-success @(currentTrangThai == TrangThaiPhieu.DaLayXe ? "active" : "")">
            @TrangThaiPhieu.DaLayXe
            @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiPhieu.DaLayXe))
            {
                <span class="badge bg-success ms-1">@Model.SoLuongTheoTrangThai[TrangThaiPhieu.DaLayXe]</span>
            }
        </a>
        <a asp-action="Index" asp-route-trangThai="@TrangThaiPhieu.DaHuy" class="btn btn-outline-secondary @(currentTrangThai == TrangThaiPhieu.DaHuy ? "active" : "")">
            @TrangThaiPhieu.DaHuy
            @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiPhieu.DaHuy))
            {
                <span class="badge bg-secondary ms-1">@Model.SoLuongTheoTrangThai[TrangThaiPhieu.DaHuy]</span>
            }
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Biển số xe</th>
                            <th>Vị trí đỗ</th>
                            <th>Ngày đăng ký</th>
                            <th>Dự kiến vào</th>
                            <th>Dự kiến ra</th>
                            <th>Đơn giá/giờ</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach != null && Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaPhieu</td>
                                    <td class="text-center text-primary fw-bold">
                                        @(item.PhuongTien?.BienSoXe ?? item.MaPhuongTien.ToString())
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold">@(item.ViTriDoXe?.TenViTri ?? item.MaViTri.ToString())</span>
                                        @if (item.ViTriDoXe != null)
                                        {
                                            <br /><small class="text-muted">(@item.ViTriDoXe.KhuVuc - Tầng @item.ViTriDoXe.Tang)</small>
                                        }
                                    </td>
                                    <td class="text-center">@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">@item.ThoiGianDuKienVao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">@item.ThoiGianDuKienRa.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end text-danger fw-bold">@item.DonGiaTheoGio.ToString("N0") VNĐ</td>
                                    <td class="text-end text-danger fw-bold">
                                        @(item.ThanhTien.HasValue ? item.ThanhTien.Value.ToString("N0") + " VNĐ" : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == TrangThaiPhieu.ChoXacNhan)
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1">@TrangThaiPhieu.ChoXacNhan</span>
                                        }
                                        else if (item.TrangThai == TrangThaiPhieu.DangGui)
                                        {
                                            <span class="badge bg-info text-white px-2 py-1">@TrangThaiPhieu.DangGui</span>
                                        }
                                        else if (item.TrangThai == TrangThaiPhieu.DaLayXe)
                                        {
                                            <span class="badge bg-success px-2 py-1">@TrangThaiPhieu.DaLayXe</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaPhieu" class="btn btn-outline-info" title="Xem chi tiết">
                                                Xem
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaPhieu" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            @if (item.TrangThai == TrangThaiPhieu.ChoXacNhan)
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.MaPhieu" class="btn btn-outline-danger" title="Hủy phiếu gửi">
                                                    Hủy
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    Không tìm thấy phiếu gửi xe nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>