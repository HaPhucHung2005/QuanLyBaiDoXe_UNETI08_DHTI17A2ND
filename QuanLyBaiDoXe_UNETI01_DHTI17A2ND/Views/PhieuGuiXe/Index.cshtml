@* Họ và tên: Trần Ngọc Minh - Mã SV: [điền MSSV] - Module 4 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.PhieuGuiXeFilterViewModel
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels
@{
    ViewData["Title"] = "Quản lý phiếu gửi xe";
    var pt = new PhanTrangViewModel { Action = "Index", PageIndex = Model.PageIndex, TotalPages = Model.TotalPages,
        RouteValues = new() {
            ["searchBienSo"] = Model.SearchBienSo, ["searchChuXe"] = Model.SearchChuXe,
            ["selectedMaLoai"] = Model.SelectedMaLoai?.ToString(), ["selectedTrangThai"] = Model.SelectedTrangThai,
            ["tuNgay"] = Model.TuNgay?.ToString("yyyy-MM-dd"), ["denNgay"] = Model.DenNgay?.ToString("yyyy-MM-dd"),
            ["sortOrder"] = Model.SortOrder } };
}
<h2 class="text-primary fw-bold mb-3">🎫 QUẢN LÝ PHIẾU GỬI XE <small class="text-muted fs-6">(@Model.TotalItems phiếu)</small></h2>
<div class="card p-3 mb-3 bg-light border-0 shadow-sm">
    <form asp-action="Index" method="get" class="row g-2">
        <div class="col-md-2"><input name="searchBienSo" value="@Model.SearchBienSo" class="form-control" placeholder="Biển số xe" /></div>
        <div class="col-md-2"><input name="searchChuXe" value="@Model.SearchChuXe" class="form-control" placeholder="Tên chủ xe" /></div>
        <div class="col-md-2"><select name="selectedMaLoai" asp-items="Model.LoaiList" class="form-select"><option value="">-- Loại xe --</option></select></div>
        <div class="col-md-2"><select name="selectedTrangThai" asp-items="Model.TrangThaiList" class="form-select"><option value="">-- Trạng thái --</option></select></div>
        <div class="col-md-2"><input type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Đăng ký từ ngày" /></div>
        <div class="col-md-2"><input type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Đăng ký đến ngày" /></div>
        <div class="col-md-3">
            <select name="sortOrder" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Ngày đăng ký mới nhất</option>
                <option value="ngay_asc" selected="@(Model.SortOrder == "ngay_asc")">Ngày đăng ký cũ nhất</option>
                <option value="tien_desc" selected="@(Model.SortOrder == "tien_desc")">Thành tiền cao → thấp</option>
                <option value="tien_asc" selected="@(Model.SortOrder == "tien_asc")">Thành tiền thấp → cao</option>
            </select>
        </div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary fw-bold">🔍 Lọc</button></div>
        <div class="col-md-2 d-grid"><a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div>
    </form>
</div>
<table class="table table-bordered table-hover align-middle bg-white shadow-sm">
    <thead class="table-primary text-center"><tr><th>Mã</th><th>Biển số</th><th>Chủ xe</th><th>Loại</th><th>Vị trí</th><th>Ngày đăng ký</th><th>Dự kiến vào → ra</th><th>Thành tiền</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.DanhSach)
    {
        <tr>
            <td class="text-center">#@p.MaPhieu</td>
            <td class="fw-bold">@p.PhuongTien?.BienSoXe</td>
            <td>@p.PhuongTien?.ChuPhuongTien?.HoTen</td>
            <td class="text-center">@p.PhuongTien?.LoaiPhuongTien?.TenLoaiPhuongTien</td>
            <td class="text-center">@p.ViTriDoXe?.TenViTri</td>
            <td class="text-center">@p.NgayDangKy.ToString("dd/MM/yyyy")</td>
            <td class="small">@p.ThoiGianDuKienVao.ToString("dd/MM HH:mm") → @p.ThoiGianDuKienRa.ToString("dd/MM HH:mm")</td>
            <td class="text-end">@(p.ThanhTien.HasValue ? p.ThanhTien.Value.ToString("N0") : "—")</td>
            <td class="text-center"><partial name="_TrangThaiPhieuBadge" model="p.TrangThai" /></td>
            <td class="text-center"><a asp-action="Details" asp-route-id="@p.MaPhieu" class="btn btn-sm btn-outline-info">Chi tiết</a></td>
        </tr>
    }
    @if (!Model.DanhSach.Any()) { <tr><td colspan="10" class="text-center text-muted py-3">Không có phiếu gửi xe phù hợp.</td></tr> }
    </tbody>
</table>
<partial name="_PhanTrang" model="pt" />
