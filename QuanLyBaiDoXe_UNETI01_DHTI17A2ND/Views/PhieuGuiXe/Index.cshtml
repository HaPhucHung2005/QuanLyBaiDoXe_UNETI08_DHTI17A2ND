@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Giao diện Danh sách và Lịch sử Phiếu gửi xe (Module 3)
*@

@model IEnumerable<QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhieuGuiXe>

@{
    ViewData["Title"] = "Danh Sách Phiếu Gửi Xe";
    var currentTrangThai = ViewBag.CurrentTrangThai as string;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-receipt"></i> Lịch Sử & Danh Sách Phiếu Gửi Xe
        </h2>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle"></i> Đăng Ký Gửi Xe Mới
        </a>
    </div>

    @* Thông báo thành công / lỗi từ TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Bộ lọc trạng thái phiếu gửi xe (Mục 7.6) *@
    <div class="btn-group mb-3" role="group">
        <a asp-action="Index" class="btn btn-outline-primary @(string.IsNullOrEmpty(currentTrangThai) ? "active" : "")">
            Tất cả
        </a>
        <a asp-action="Index" asp-route-trangThai="Chờ xác nhận" class="btn btn-outline-warning @(currentTrangThai == "Chờ xác nhận" ? "active" : "")">
            Chờ xác nhận
        </a>
        <a asp-action="Index" asp-route-trangThai="Đang gửi" class="btn btn-outline-info @(currentTrangThai == "Đang gửi" ? "active" : "")">
            Đang gửi
        </a>
        <a asp-action="Index" asp-route-trangThai="Đã lấy xe" class="btn btn-outline-success @(currentTrangThai == "Đã lấy xe" ? "active" : "")">
            Đã lấy xe
        </a>
        <a asp-action="Index" asp-route-trangThai="Đã hủy" class="btn btn-outline-secondary @(currentTrangThai == "Đã hủy" ? "active" : "")">
            Đã hủy
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Biển số xe</th>
                            <th>Vị trí đỗ</th>
                            <th>Ngày đăng ký</th>
                            <th>Dự kiến vào</th>
                            <th>Dự kiến ra</th>
                            <th>Đơn giá/giờ</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaPhieu</td>
                                    <td class="text-center text-primary fw-bold">
                                        @(item.PhuongTien?.BienSoXe ?? item.MaPhuongTien.ToString())
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold">@(item.ViTriDoXe?.TenViTri ?? item.MaViTri.ToString())</span>
                                        @if (item.ViTriDoXe != null)
                                        {
                                            <br /><small class="text-muted">(@item.ViTriDoXe.KhuVuc - Tầng @item.ViTriDoXe.Tang)</small>
                                        }
                                    </td>
                                    <td class="text-center">@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">@item.ThoiGianDuKienVao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">@item.ThoiGianDuKienRa.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end text-danger fw-bold">@item.DonGiaTheoGio.ToString("N0") VNĐ</td>
                                    <td class="text-end text-danger fw-bold">
                                        @(item.ThanhTien.HasValue ? item.ThanhTien.Value.ToString("N0") + " VNĐ" : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1">Chờ xác nhận</span>
                                        }
                                        else if (item.TrangThai == "Đang gửi")
                                        {
                                            <span class="badge bg-info text-white px-2 py-1">Đang gửi</span>
                                        }
                                        else if (item.TrangThai == "Đã lấy xe")
                                        {
                                            <span class="badge bg-success px-2 py-1">Đã lấy xe</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaPhieu" class="btn btn-outline-info" title="Chi tiết">
                                                Xem
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaPhieu" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            @if (item.TrangThai == "Chờ xác nhận")
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.MaPhieu" class="btn btn-outline-danger" title="Hủy phiếu">
                                                    Hủy
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    Chưa có phiếu gửi xe nào trong danh sách.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>