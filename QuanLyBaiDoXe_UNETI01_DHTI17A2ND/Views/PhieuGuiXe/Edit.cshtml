@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Giao diện Chỉnh sửa Phiếu gửi xe (Module 3)
*@

@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhieuGuiXe

@{
    ViewData["Title"] = "Chỉnh Sửa Phiếu Gửi Xe";
}

<div class="container mt-4">
    <div class="card shadow border-warning mx-auto" style="max-width: 700px;">
        <div class="card-header bg-warning text-dark text-center fw-bold fs-5">
            CHỈNH SỬA PHIẾU GỬI XE #@Model.MaPhieu
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                @* Khóa chính và các giá trị giữ nguyên *@
                <input type="hidden" asp-for="MaPhieu" />
                <input type="hidden" asp-for="NgayDangKy" />
                <input type="hidden" asp-for="DonGiaTheoGio" />
                <input type="hidden" asp-for="ThanhTien" />
                <input type="hidden" asp-for="ThoiGianVaoThucTe" />
                <input type="hidden" asp-for="ThoiGianRaThucTe" />

                @* 1. Chọn phương tiện *@
                <div class="mb-3">
                    <label asp-for="MaPhuongTien" class="form-label fw-bold"></label>
                    <select asp-for="MaPhuongTien" class="form-select" asp-items="ViewBag.MaPhuongTien">
                        <option value="">-- Chọn phương tiện --</option>
                    </select>
                    <span asp-validation-for="MaPhuongTien" class="text-danger"></span>
                </div>

                @* 2. Chọn vị trí đỗ *@
                <div class="mb-3">
                    <label asp-for="MaViTri" class="form-label fw-bold"></label>
                    <select asp-for="MaViTri" class="form-select" asp-items="ViewBag.MaViTri">
                        <option value="">-- Chọn vị trí đỗ --</option>
                    </select>
                    <span asp-validation-for="MaViTri" class="text-danger"></span>
                </div>

                @* 3. Thời gian dự kiến vào / ra *@
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ThoiGianDuKienVao" class="form-label fw-bold"></label>
                        <input asp-for="ThoiGianDuKienVao" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ThoiGianDuKienVao" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ThoiGianDuKienRa" class="form-label fw-bold"></label>
                        <input asp-for="ThoiGianDuKienRa" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ThoiGianDuKienRa" class="text-danger"></span>
                    </div>
                </div>

                @* 4. Trạng thái phiếu *@
                <div class="mb-3">
                    <label asp-for="TrangThai" class="form-label fw-bold"></label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="Chờ xác nhận">Chờ xác nhận</option>
                        <option value="Đang gửi">Đang gửi</option>
                        <option value="Đã lấy xe">Đã lấy xe</option>
                        <option value="Đã hủy">Đã hủy</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>

                <div class="text-center mt-4">
                    <a asp-action="Index" class="btn btn-secondary me-2">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning fw-bold">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("MaPhuongTien").addEventListener("change", function () {
            var maPhuongTien = this.value;
            var selectViTri = document.getElementById("MaViTri");
            selectViTri.innerHTML = '<option value="">-- Đang tải vị trí đỗ... --</option>';

            if (maPhuongTien) {
                fetch('/PhieuGuiXe/GetViTriByPhuongTien?maPhuongTien=' + maPhuongTien)
                    .then(response => response.json())
                    .then(data => {
                        selectViTri.innerHTML = '<option value="">-- Chọn vị trí đỗ --</option>';
                        if (data && data.length > 0) {
                            data.forEach(item => {
                                selectViTri.innerHTML += `<option value="${item.maViTri}">${item.tenViTri} (${item.khuVuc} - Tầng ${item.tang})</option>`;
                            });
                        } else {
                            selectViTri.innerHTML = '<option value="">-- Không có vị trí đỗ phù hợp --</option>';
                        }
                    });
            } else {
                selectViTri.innerHTML = '<option value="">-- Vui lòng chọn phương tiện trước --</option>';
            }
        });
    </script>
}