@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Xóa Loại Phương Tiện";
}

<div class="container mt-4">
    <div class="card border-danger mx-auto" style="max-width: 600px;">
        <div class="card-header bg-danger text-white text-center fw-bold">
            XÁC NHẬN XÓA LOẠI PHƯƠNG TIỆN
        </div>
        <div class="card-body">
            <h5 class="card-title text-center text-danger mb-4">Bạn có chắc chắn muốn xóa loại phương tiện này?</h5>

            <dl class="row">
                <dt class="col-sm-4">Tên loại phương tiện:</dt>
                <dd class="col-sm-8">@Model.TenLoaiPhuongTien</dd>

                <dt class="col-sm-4">Đơn giá theo giờ:</dt>
                <dd class="col-sm-8">@Model.DonGiaTheoGio.ToString("N0") VNĐ</dd>

                <dt class="col-sm-4">Mô tả:</dt>
                <dd class="col-sm-8">@Model.MoTa</dd>

                <dt class="col-sm-4">Trạng thái:</dt>
                <dd class="col-sm-8">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Tạm ngừng</span>
                    }
                </dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post" class="text-center mt-4">
                <input type="hidden" asp-for="MaLoaiPhuongTien" />
                <a asp-action="Index" class="btn btn-secondary me-2">Quay lại danh sách</a>
                <button type="submit" class="btn btn-danger">Xác Nhận Xóa</button>
            </form>
        </div>
    </div>
</div>