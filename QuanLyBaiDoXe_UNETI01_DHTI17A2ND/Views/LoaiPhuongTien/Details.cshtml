@* Họ và tên: Hà Phúc Hưng - Mã SV: 23203100001 *@
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Chi Tiết Loại Phương Tiện";
}

<div class="row justify-content-center">
    <div class="col-md-8 card p-4 shadow-sm border-0 rounded-3">
        <h3 class="text-primary fw-bold mb-3">CHI TIẾT LOẠI PHƯƠNG TIỆN</h3>
        <hr />

        @if (Model != null)
        {
            <dl class="row fs-6">
                <dt class="col-sm-4 text-muted">
                    @Html.DisplayNameFor(model => model.TenLoaiPhuongTien)
                </dt>
                <dd class="col-sm-8 fw-bold text-dark">
                    @Html.DisplayFor(model => model.TenLoaiPhuongTien)
                </dd>

                <dt class="col-sm-4 text-muted">
                    @Html.DisplayNameFor(model => model.DonGiaTheoGio)
                </dt>
                <dd class="col-sm-8 text-success fw-bold">
                    @Model.DonGiaTheoGio.ToString("N0") VNĐ
                </dd>

                <dt class="col-sm-4 text-muted">
                    @Html.DisplayNameFor(model => model.TrangThai)
                </dt>
                <dd class="col-sm-8">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Tạm ngừng</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">
                    @Html.DisplayNameFor(model => model.DanhSachViTriDoXe)
                </dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary rounded-pill px-3">
                        @(Model.DanhSachViTriDoXe?.Count ?? 0) vị trí đỗ
                    </span>
                </dd>

                <dt class="col-sm-4 text-muted">
                    @Html.DisplayNameFor(model => model.MoTa)
                </dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có mô tả" : Model.MoTa)
                </dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                <a asp-action="Edit" asp-route-id="@Model.MaLoaiPhuongTien" class="btn btn-warning fw-bold px-4">Chỉnh Sửa</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                Không tìm thấy thông tin loại phương tiện.
            </div>
            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
            </div>
        }
    </div>
</div>