@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Module 1 - Xem chi tiết loại phương tiện
*@

@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Chi Tiết Loại Phương Tiện";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-info text-white fw-bold py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-info-circle-fill me-2"></i>CHI TIẾT LOẠI PHƯƠNG TIỆN</h4>
                </div>
                <div class="card-body p-4">
                    @if (Model != null)
                    {
                        <dl class="row mb-0 align-items-center fs-6">
                            <dt class="col-sm-4 text-muted">Mã loại xe:</dt>
                            <dd class="col-sm-8 fw-bold">#@Model.MaLoaiPhuongTien</dd>

                            <dt class="col-sm-4 text-muted">Tên loại xe:</dt>
                            <dd class="col-sm-8 fw-bold text-primary fs-5">@Model.TenLoaiPhuongTien</dd>

                            <dt class="col-sm-4 text-muted">Đơn giá / giờ:</dt>
                            <dd class="col-sm-8 text-success fw-bold fs-5">@Model.DonGiaTheoGio.ToString("N0") VNĐ</dd>

                            <dt class="col-sm-4 text-muted">Số vị trí đỗ:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-primary px-3 py-2 rounded-pill">
                                    <i class="bi bi-p-square-fill me-1"></i> @(Model.DanhSachViTriDoXe?.Count ?? 0) vị trí
                                </span>
                            </dd>

                            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                            <dd class="col-sm-8">
                                @if (Model.TrangThai)
                                {
                                    <span class="badge bg-success px-2 py-1">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">Tạm ngừng</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted">Mô tả ghi chú:</dt>
                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có mô tả" : Model.MoTa)
                            </dd>
                        </dl>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Không tìm thấy thông tin loại phương tiện.
                        </div>
                    }
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">
                        ← Quay lại danh sách
                    </a>
                    @if (Model != null)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MaLoaiPhuongTien" class="btn btn-warning px-4 fw-bold">
                            ✏️ Chỉnh Sửa
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>