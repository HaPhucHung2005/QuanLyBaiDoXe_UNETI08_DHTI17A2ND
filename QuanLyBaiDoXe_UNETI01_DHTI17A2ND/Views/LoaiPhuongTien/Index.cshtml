@* Họ và tên: Hà Phúc Hưng - Mã SV: 23203100001 *@

@model IEnumerable<QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.LoaiPhuongTien>

@{
    ViewData["Title"] = "Quản Lý Loại Phương Tiện";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary fw-bold">QUẢN LÝ LOẠI PHƯƠNG TIỆN</h2>
    <a asp-action="Create" class="btn btn-success fw-bold">+ Thêm Loại Phương Tiện</a>
</div>

<table class="table table-bordered table-hover align-middle shadow-sm">
    <thead class="table-primary text-center">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenLoaiPhuongTien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonGiaTheoGio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DanhSachViTriDoXe)
            </th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold text-dark">
                        @Html.DisplayFor(model => item.TenLoaiPhuongTien)
                    </td>
                    <td class="text-end text-success fw-bold">
                        @item.DonGiaTheoGio.ToString("N0") VNĐ
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.MoTa)
                    </td>
                    <td class="text-center">
                        @if (item.TrangThai)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                        }
                    </td>
                    <td class="text-center">
                        <span class="badge bg-primary rounded-pill px-3">
                            @(item.DanhSachViTriDoXe?.Count ?? 0) vị trí
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.MaLoaiPhuongTien" class="btn btn-outline-primary">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.MaLoaiPhuongTien" class="btn btn-outline-info">Xem</a>
                            <a asp-action="Delete" asp-route-id="@item.MaLoaiPhuongTien" class="btn btn-outline-danger">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-3">Chưa có dữ liệu loại phương tiện nào.</td>
            </tr>
        }
    </tbody>
</table>