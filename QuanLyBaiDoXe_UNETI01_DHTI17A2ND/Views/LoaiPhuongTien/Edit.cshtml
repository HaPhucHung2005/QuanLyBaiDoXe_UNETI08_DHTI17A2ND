@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Module 1 - Chỉnh sửa thông tin loại phương tiện
*@

@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Chỉnh Sửa Loại Phương Tiện";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark fw-bold py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA LOẠI PHƯƠNG TIỆN</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <!-- Khóa chính ẩn -->
                        <input type="hidden" asp-for="MaLoaiPhuongTien" />

                        <div class="mb-3">
                            <label asp-for="TenLoaiPhuongTien" class="form-label fw-bold small">Tên loại phương tiện</label>
                            <input asp-for="TenLoaiPhuongTien" class="form-control" placeholder="Nhập tên loại xe..." />
                            <span asp-validation-for="TenLoaiPhuongTien" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DonGiaTheoGio" class="form-label fw-bold small">Đơn giá theo giờ (VNĐ)</label>
                            <div class="input-group">
                                <input asp-for="DonGiaTheoGio" class="form-control" type="number" step="1000" min="0" placeholder="vd: 5000" />
                                <span class="input-group-text bg-light">VNĐ/giờ</span>
                            </div>
                            <span asp-validation-for="DonGiaTheoGio" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold small">Mô tả ghi chú</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Ghi chú thêm thông tin về loại xe..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small d-block">Trạng thái áp dụng</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="switchTrangThai" />
                                <label class="form-check-label fw-semibold" for="switchTrangThai">
                                    Đang hoạt động (Cho phép sử dụng)
                                </label>
                            </div>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                                ← Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                                💾 Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}