@*
    Họ và tên: Hà Phúc Hưng - Trần Ngọc Minh
    Mã sinh viên: 23203100001 - MSSV
    Nội dung thực hiện: Giao diện Xác nhận hủy / xóa phiếu gửi xe (Module 3)
*@
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.PhieuGuiXe

@{
    ViewData["Title"] = "Hủy Phiếu Gửi Xe";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header bg-danger text-white text-center fw-bold fs-5">
            <i class="bi bi-exclamation-triangle-fill"></i> XÁC NHẬN HỦY / XÓA PHIẾU GỬI XE
        </div>
        <div class="card-body">
            <h5 class="card-title text-center text-danger mb-3">
                Bạn có chắc chắn muốn hủy hoặc xóa phiếu gửi xe này không?
            </h5>

            @if (Model.TrangThai != TrangThaiPhieu.ChoXacNhan)
            {
                <div class="alert alert-warning text-center" role="alert">
                    <i class="bi bi-shield-exclamation"></i> <strong>Lưu ý:</strong> Phiếu này đang ở trạng thái <strong>@Model.TrangThai</strong>. Chỉ có Quản trị viên (Admin) mới có quyền can thiệp xóa phiếu sau khi đã xác nhận.
                </div>
            }

            <dl class="row px-3 fs-6">
                <dt class="col-sm-4 fw-bold mb-2">Mã phiếu:</dt>
                <dd class="col-sm-8 mb-2">#@Model.MaPhieu</dd>

                <dt class="col-sm-4 fw-bold mb-2">Biển số xe:</dt>
                <dd class="col-sm-8 mb-2 text-primary fw-bold">
                    @(Model.PhuongTien?.BienSoXe ?? Model.MaPhuongTien.ToString())
                    @if (Model.PhuongTien != null)
                    {
                        <span class="text-muted fw-normal">(@Model.PhuongTien.NhanHieu - @Model.PhuongTien.MauSac)</span>
                    }
                </dd>

                <dt class="col-sm-4 fw-bold mb-2">Vị trí đỗ xe:</dt>
                <dd class="col-sm-8 mb-2">
                    <span class="fw-bold text-success">@(Model.ViTriDoXe?.TenViTri ?? Model.MaViTri.ToString())</span>
                    @if (Model.ViTriDoXe != null)
                    {
                        <span class="text-muted">(@Model.ViTriDoXe.KhuVuc - Tầng @Model.ViTriDoXe.Tang)</span>
                    }
                </dd>

                <dt class="col-sm-4 fw-bold mb-2">Ngày đăng ký:</dt>
                <dd class="col-sm-8 mb-2">@Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</dd>

                <hr class="my-2" />

                <dt class="col-sm-4 fw-bold mb-2">Thời gian dự kiến vào:</dt>
                <dd class="col-sm-8 mb-2">@Model.ThoiGianDuKienVao.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4 fw-bold mb-2">Thời gian dự kiến ra:</dt>
                <dd class="col-sm-8 mb-2">@Model.ThoiGianDuKienRa.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4 fw-bold mb-2">Đơn giá theo giờ:</dt>
                <dd class="col-sm-8 mb-2 text-danger fw-bold">@Model.DonGiaTheoGio.ToString("N0") VNĐ</dd>

                <dt class="col-sm-4 fw-bold mb-2">Thành tiền:</dt>
                <dd class="col-sm-8 mb-2 text-danger fw-bold">
                    @(Model.ThanhTien.HasValue ? Model.ThanhTien.Value.ToString("N0") + " VNĐ" : "Chưa tính")
                </dd>

                <dt class="col-sm-4 fw-bold mb-2">Trạng thái phiếu:</dt>
                <dd class="col-sm-8 mb-2">
                    @if (Model.TrangThai == TrangThaiPhieu.ChoXacNhan)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">@TrangThaiPhieu.ChoXacNhan</span>
                    }
                    else if (Model.TrangThai == TrangThaiPhieu.DangGui)
                    {
                        <span class="badge bg-info text-white px-3 py-2">@TrangThaiPhieu.DangGui</span>
                    }
                    else if (Model.TrangThai == TrangThaiPhieu.DaLayXe)
                    {
                        <span class="badge bg-success px-3 py-2">@TrangThaiPhieu.DaLayXe</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">@Model.TrangThai</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" class="text-center mt-4">
                <input type="hidden" asp-for="MaPhieu" />
                <a asp-action="Index" class="btn btn-secondary me-2">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-danger fw-bold">
                    <i class="bi bi-trash-fill"></i> Xác Nhận Hủy / Xóa
                </button>
            </form>
        </div>
    </div>
</div>