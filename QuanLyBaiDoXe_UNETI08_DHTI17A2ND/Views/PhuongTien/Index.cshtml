@*
    Họ và tên: Hà Phúc Hưng - Trần Ngọc Minh
    Mã sinh viên: 23203100001 - MSSV
    Nội dung thực hiện: Giao diện Danh sách Phương tiện (Module 3)
*@
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.PhuongTienFilterViewModel

@{
    ViewData["Title"] = "Danh Sách Phương Tiện";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-car-front-fill"></i> Quản Lý Phương Tiện
        </h2>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle"></i> Thêm Phương Tiện Mới
        </a>
    </div>

    @* Thông báo thành công / lỗi từ TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Khung tìm kiếm và bộ lọc nâng cao *@
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <div class="input-group">
                <input type="text" name="searchBienSo" value="@Model.SearchBienSo" class="form-control" placeholder="Nhập biển số xe, nhãn hiệu..." />
                <button type="submit" class="btn btn-primary fw-bold">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <select name="selectedMaLoai" asp-items="Model.LoaiList" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả loại xe --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="hoatdong" selected="@(Model.TrangThai == "hoatdong")">Hoạt động</option>
                <option value="tamngung" selected="@(Model.TrangThai == "tamngung")">Tạm ngừng</option>
            </select>
        </div>
        @if (!string.IsNullOrEmpty(Model.SearchBienSo) || Model.SelectedMaLoai.HasValue || !string.IsNullOrEmpty(Model.TrangThai))
        {
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa bộ lọc</a>
            </div>
        }
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Mã xe</th>
                            <th>Biển số xe</th>
                            <th>Loại phương tiện</th>
                            <th>Chủ phương tiện</th>
                            <th>Nhãn hiệu</th>
                            <th>Màu sắc</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach != null && Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaPhuongTien</td>
                                    <td class="text-center text-primary fw-bold fs-6">
                                        @item.BienSoXe
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @(item.LoaiPhuongTien?.TenLoaiPhuongTien ?? item.MaLoaiPhuongTien.ToString())
                                    </td>
                                    <td class="fw-bold">
                                        @(item.ChuPhuongTien?.HoTen ?? item.MaChuPhuongTien.ToString())
                                    </td>
                                    <td class="text-center">@(string.IsNullOrEmpty(item.NhanHieu) ? "-" : item.NhanHieu)</td>
                                    <td class="text-center">@(string.IsNullOrEmpty(item.MauSac) ? "-" : item.MauSac)</td>
                                    <td>@(string.IsNullOrEmpty(item.MoTa) ? "-" : item.MoTa)</td>
                                    <td class="text-center">
                                        @if (item.TrangThai == TrangThaiHoatDong.HoatDong)
                                        {
                                            <span class="badge bg-success px-2 py-1">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">Tạm ngừng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaPhuongTien" class="btn btn-outline-info" title="Xem chi tiết">
                                                Xem
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaPhuongTien" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaPhuongTien" class="btn btn-outline-danger" title="Xóa">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    Chưa có phương tiện nào trong danh sách.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>