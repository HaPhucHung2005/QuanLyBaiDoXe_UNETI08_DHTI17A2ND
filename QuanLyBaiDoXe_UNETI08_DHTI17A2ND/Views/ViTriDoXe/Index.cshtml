@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Module 2 - Giao diện Quản lý & Tra cứu Vị trí đỗ xe (Search, Filter, Sort & Pagination)
*@

@using Microsoft.AspNetCore.Http
@using QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models
@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.ViewModels.ViTriDoXeFilterViewModel

@{
    ViewData["Title"] = "Quản Lý & Tra Cứu Vị Trí Đỗ Xe";
    bool isAdmin = Context.Session.GetString("VaiTro") == "Admin";
}

<div class="container-fluid mt-3">
    <!-- Thống báo trạng thái TempData -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Loi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary fw-bold mb-0">
            <i class="bi bi-p-square-fill me-2"></i>TRA CỨU & QUẢN LÝ VỊ TRÍ ĐỖ XE
        </h3>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Thêm Vị Trí Mới
            </a>
        }
    </div>

    <!-- FORM TÌM KIẾM, LỌC VÀ SẮP XẾP -->
    <div class="card p-3 mb-4 shadow-sm border-0 bg-light rounded-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchTenViTri" value="@Model.SearchTenViTri" class="form-control" placeholder="Tên vị trí (vd: A01, B02)..." />
            </div>
            <div class="col-md-2">
                <select name="searchKhuVuc" asp-items="Model.KhuVucList" class="form-select">
                    <option value="">-- Tất cả khu vực --</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="selectedMaLoaiPhuongTien" asp-items="Model.LoaiPhuongTienList" class="form-select">
                    <option value="">-- Loại phương tiện --</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="selectedTrangThai" asp-items="Model.TrangThaiList" class="form-select">
                    <option value="">-- Trạng thái --</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sortOrder" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Tên A-Z</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Tên Z-A</option>
                    <option value="tang_asc" selected="@(Model.SortOrder == "tang_asc")">Tầng thấp → cao</option>
                    <option value="tang_desc" selected="@(Model.SortOrder == "tang_desc")">Tầng cao → thấp</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary fw-bold w-100" title="Tìm kiếm">
                    <i class="bi bi-search"></i>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH SÁCH -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>Tên Vị Trí</th>
                            <th>Khu Vực</th>
                            <th>Tầng</th>
                            <th>Loại Xe Khả Dụng</th>
                            <th>Đơn Giá / Giờ</th>
                            <th>Trạng Thái</th>
                            <th width="180px">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachViTri != null && Model.DanhSachViTri.Any())
                        {
                            @foreach (var item in Model.DanhSachViTri)
                            {
                                <tr>
                                    <td class="fw-bold text-primary text-center px-3">@item.TenViTri</td>
                                    <td class="text-center">@item.KhuVuc</td>
                                    <td class="text-center">Tầng @item.Tang</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-car-front me-1"></i>@(item.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Chưa xếp")
                                        </span>
                                    </td>
                                    <td class="text-end text-success fw-bold px-3">
                                        @(item.LoaiPhuongTien != null ? item.LoaiPhuongTien.DonGiaTheoGio.ToString("N0") + " VNĐ" : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == TrangThaiViTri.ConTrong)
                                        {
                                            <span class="badge bg-success px-2 py-1">Còn trống</span>
                                        }
                                        else if (item.TrangThai == TrangThaiViTri.DangSuDung)
                                        {
                                            <span class="badge bg-danger px-2 py-1">Đang sử dụng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaViTri" class="btn btn-outline-info" title="Xem chi tiết">
                                                <i class="bi bi-eye-fill"></i> Xem
                                            </a>
                                            @if (isAdmin)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.MaViTri" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                    <i class="bi bi-pencil-square"></i> Sửa
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.MaViTri" class="btn btn-outline-danger" title="Xóa">
                                                    <i class="bi bi-trash-fill"></i> Xóa
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    Không tìm thấy vị trí đỗ xe nào phù hợp với bộ lọc.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- THANH PHÂN TRANG -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTenViTri="@Model.SearchTenViTri"
                       asp-route-searchKhuVuc="@Model.SearchKhuVuc"
                       asp-route-selectedMaLoaiPhuongTien="@Model.SelectedMaLoaiPhuongTien"
                       asp-route-selectedTang="@Model.SelectedTang"
                       asp-route-selectedTrangThai="@Model.SelectedTrangThai"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-pageIndex="@(Model.PageIndex - 1)">« Trước</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-searchTenViTri="@Model.SearchTenViTri"
                           asp-route-searchKhuVuc="@Model.SearchKhuVuc"
                           asp-route-selectedMaLoaiPhuongTien="@Model.SelectedMaLoaiPhuongTien"
                           asp-route-selectedTang="@Model.SelectedTang"
                           asp-route-selectedTrangThai="@Model.SelectedTrangThai"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-pageIndex="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTenViTri="@Model.SearchTenViTri"
                       asp-route-searchKhuVuc="@Model.SearchKhuVuc"
                       asp-route-selectedMaLoaiPhuongTien="@Model.SelectedMaLoaiPhuongTien"
                       asp-route-selectedTang="@Model.SelectedTang"
                       asp-route-selectedTrangThai="@Model.SelectedTrangThai"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-pageIndex="@(Model.PageIndex + 1)">Sau »</a>
                </li>
            </ul>
        </nav>
    }
</div>