@*
    Họ và tên: Hà Phúc Hưng
    Mã sinh viên: 23203100001
    Nội dung thực hiện: Module 1 - Cảnh báo và xác nhận xóa loại phương tiện
*@

@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Xóa Loại Phương Tiện";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger rounded-3">
                <div class="card-header bg-danger text-white fw-bold py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA LOẠI PHƯƠNG TIỆN</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 mb-3 small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa loại phương tiện này khỏi hệ thống? Hành động này không thể hoàn tác.
                    </div>

                    <dl class="row mb-0 align-items-center">
                        <dt class="col-sm-4 text-muted">Mã loại xe:</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.MaLoaiPhuongTien</dd>

                        <dt class="col-sm-4 text-muted">Tên loại xe:</dt>
                        <dd class="col-sm-8 fw-bold text-danger">@Model.TenLoaiPhuongTien</dd>

                        <dt class="col-sm-4 text-muted">Đơn giá / giờ:</dt>
                        <dd class="col-sm-8 text-primary fw-bold">@Model.DonGiaTheoGio.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-4 text-muted">Mô tả:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)</dd>

                        <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success px-2 py-1">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-2 py-1">Tạm ngừng</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">
                        ← Hủy bỏ & Quay lại
                    </a>
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="MaLoaiPhuongTien" />
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            🗑️ Xác Nhận Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>