@*
    Họ và tên: Hà Phúc Hưng
    Mã SV: 23203100001
    Nội dung thực hiện: Module 1 - Quản lý tài khoản, Đăng nhập, Phân quyền
*@

@model IEnumerable<QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản";
}

<div class="container-fluid mt-3">
    <!-- Header & Nút Thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold mb-0">
            <i class="bi bi-people-fill"></i> QUẢN LÝ TÀI KHOẢN HỆ THỐNG
        </h2>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> Tạo Tài Khoản Mới
        </a>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Loi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bảng hiển thị danh sách tài khoản -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Mã TK</th>
                            <th>Tên đăng nhập</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaTaiKhoan</td>
                                    <td class="fw-bold text-primary">@item.TenDangNhap</td>
                                    <td>@item.HoTen</td>
                                    <td>@item.Email</td>
                                    <td class="text-center">
                                        @if (item.VaiTro == "Admin")
                                        {
                                            <span class="badge bg-danger px-2 py-1">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark px-2 py-1">Khách hàng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success px-2 py-1">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">Đã bị khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-info" title="Xem chi tiết">
                                                Xem
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-danger" title="Khóa/Xóa">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Chưa có tài khoản nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>