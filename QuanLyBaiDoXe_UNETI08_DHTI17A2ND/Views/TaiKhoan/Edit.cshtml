@*
    Họ và tên: Hà Phúc Hưng
    Mã SV: 23203100001
    Nội dung thực hiện: Module 1 - Cập nhật thông tin tài khoản, phân quyền và trạng thái
*@

@model QuanLyBaiDoXe_UNETI01_DHTI17A2ND.Models.TaiKhoan

@{
    ViewData["Title"] = "Cập Nhật Tài Khoản";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark fw-bold py-3">
                    <h4 class="mb-0 fs-5"><i class="bi bi-pencil-square me-2"></i>CẬP NHẬT TÀI KHOẢN</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <input type="hidden" asp-for="MaTaiKhoan" />

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-bold small">Tên đăng nhập</label>
                            <input asp-for="TenDangNhap" class="form-control bg-light" readonly />
                            <small class="text-muted fs-7">Tên đăng nhập không được phép thay đổi.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-bold small">Mật khẩu mới</label>
                            <!-- Thêm data-val="false" và value="" để bỏ qua bắt buộc nhập mật khẩu khi chỉnh sửa -->
                            <input asp-for="MatKhau" type="password" class="form-control" value="" data-val="false" placeholder="Nhập mật khẩu mới..." />
                            <small class="text-muted fs-7">Để trống nếu muốn giữ nguyên mật khẩu cũ.</small>
                            <span asp-validation-for="MatKhau" class="text-danger small d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label fw-bold small">Họ và tên</label>
                            <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên..." />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold small">Địa chỉ Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="example@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VaiTro" class="form-label fw-bold small">Vai trò hệ thống</label>
                            <select asp-for="VaiTro" class="form-select">
                                <option value="Khách hàng">Khách hàng</option>
                                <option value="Admin">Admin</option>
                            </select>
                            <span asp-validation-for="VaiTro" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small d-block">Trạng thái tài khoản</label>
                            <div class="form-check form-switch">
                                <input asp-for="TrangThai" class="form-check-input" type="checkbox" id="switchTrangThai" />
                                <label class="form-check-label fw-semibold" for="switchTrangThai">
                                    Hoạt động (Cho phép đăng nhập)
                                </label>
                            </div>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                                ← Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">
                                💾 Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}